{
    "_version": "1.15.0",
    "sap.app": {
        "id": "cards.creditburndown",
        "type": "card",
        "i18n": "i18n/i18n.properties",
        "title": "{{title}}",
        "description": "{{description}}",
        "applicationVersion": {
            "version": "2.0.1"
        }
    },
    "sap.ui": {
        "technology": "UI5",
        "deviceTypes": {
            "desktop": true,
            "phone": true,
            "tablet": true
        },
        "icons": {
            "icon": "sap-icon://compare-2"
        }
    },
    "sap.card": {
        "type": "Analytical",
        "designtime": "dt/configuration",
        "header": {
            "type": "Numeric",
            "data": {
                "name": "headerData",
                "request": {
                    "url": "{{destinations.btprc-srv}}/odata/v4/contracts/Card_CreditBurnDownHeaders",
                    "withCredentials": true,
                    "parameters": {
                        "$filter": "globalAccountId eq '{filters>/account/selectedItem/additionalText}'"
                    }
                }
            },
            "title": "{{title}}",
            "subTitle": "{{subtitle}}",
            "details": "Phase start: {headerData>/value/0/Credits_phaseStartDate}",
            "mainIndicator": {
                "number": "{= format.currency(${headerData>/value/0/Credits_balance}, ${headerData>/value/0/currency}, {currencyCode:true})}",
                "state": "Good"
            },
            "sideIndicators": [
                {
                    "title": "Contract Value",
                    "number": "{= format.currency(${headerData>/value/0/Credits_cloudCreditsForPhase}, ${headerData>/value/0/currency}, {currencyCode:true})}"
                },
                {
                    "title": "Used in {month}",
                    "number": "{= format.currency(${headerData>/value/0/Measures_cloudCreditsCost}, ${headerData>/value/0/currency}, {currencyCode:true})}"
                }
            ],
            "actions": []
        },
        "content": {
            "data": {
                "request": {
                    "url": "{{destinations.btprc-srv}}/odata/v4/contracts/Card_CreditBurnDowns",
                    "withCredentials": true,
                    "parameters": {
                        "$filter": "globalAccountId eq '{filters>/account/selectedItem/additionalText}'"
                    }
                },
                "path": "/value"
            },
            "chartType": "stacked_combination",
            "tooltips": true,
            "chartProperties": {
                "title": {
                    "visible": false
                },
                "legend": {
                    "visible": true
                },
                "plotArea": {
                    "dataPointStyle": {
                        "rules": [
							{
                                "dataContext": {
									"Balance": {
                                        "max": "{= parseFloat(${headerData>/value/0/Credits_cloudCreditsForPhase}) * ${parameters>/RemainingCreditsWarningPct/value} }"
									},
                                    "Status": "Projection"
                                },
								"properties": {
									"color": "red"
								},
								"displayName": "Projection / Balance Warning"
							},
                            {
                                "dataContext": {
									"Balance": {
                                        "min": "{= parseFloat(${headerData>/value/0/Credits_cloudCreditsForPhase}) * ${parameters>/RemainingCreditsWarningPct/value} + 0.01 }"
									},
                                    "Status": "Projection"
                                },
								"properties": {
									"color": "lightgreen"
								},
								"displayName": "Projection / Balance"
							},
                            {
                                "dataContext": {
									"measureNames": "Contract",
                                    "Status": "Projection"
                                },
								"properties": {
									"color": "lightblue",
                                    "lineType": "solid",
                                    "lineColor": "lightblue"
								},
								"displayName": "Projection / Contract"
							},
                            {
                                "dataContext": {
									"measureNames": "Contract",
                                    "Status": "Actual"
                                },
								"properties": {
									"color": "darkblue",
                                    "lineType": "solid",
                                    "lineColor": "darkblue"
								},
								"displayName": "Actual / Contract"
							},
                            {
                                "dataContext": {
									"measureNames": "Balance",
                                    "Status": "Actual"
                                },
								"properties": {
									"color": "darkgreen"
								},
								"displayName": "Actual / Balance"
							}
                        ]
                    },
                    "dataLabel": {
                        "visible": true
                    }
                },
                "categoryAxis": {
                    "title": {
                        "visible": false
                    }
                },
                "valueAxis": {
                    "title": {
                        "visible": false
                    }
                }
            },
            "dimensions": [
                {
                    "name": "Month",
                    "value": "{month}"
                },
                {
                    "name": "Status",
                    "value": "{Credits_status}"
                }
            ],
            "measures": [
                {
                    "name": "Balance",
                    "value": "{chartBalance}"
                },
                {
                    "name": "Contract",
                    "value": "{Credits_cloudCreditsForPhase}"
                }
            ],
            "feeds": [
                {
                    "uid": "valueAxis",
                    "type": "Measure",
                    "values": [
                        "Balance",
                        "Contract"
                    ]
                },
                {
                    "uid": "categoryAxis",
                    "type": "Dimension",
                    "values": [
                        "Month"
                    ]
                },
                {
                    "uid": "color",
                    "type": "Dimension",
                    "values": [
                        "Status"
                    ]
                }
            ]
        },
        "configuration": {
            "filters": {
                "account": {
                    "selectedKey": "1",
                    "type": "ComboBox",
                    "label": "Global Account",
                    "placeholder": "account",
                    "data": {
                        "request": {
                            "url": "{{destinations.btprc-srv}}/odata/v4/contracts/unique_globalAccountNames",
                            "withCredentials": true,
                            "parameters": {
                                "$orderby": "name"
                            }
                        },
                        "path": "/value"
                    },
                    "item": {
                        "path": "/value",
                        "template": {
                            "key": "{position}",
                            "title": "{name}",
                            "additionalText": "{ID}"
                        }
                    }
                }
            },
            "destinations": {
                "btprc-srv": {
                    "name": "btprc-srv",
                    "defaultUrl": "/odata/v4/contracts/Card_CreditBurnDowns"
                }
            },
            "parameters": {
                "RemainingCreditsWarningPct": {
                    "value": 0.25,
                    "type": "number"
                }
            }
        }
    },
    "sap.platform.mobilecards": {
        "compatible": false
    }
}